        "documents_region_matches_type": {
          "name": "documents_region_matches_type",
          "value": "(\"documents\".\"type\" = 'national' AND \"documents\".\"region_id\" IS NULL) OR (\"documents\".\"type\" = 'regional' AND \"documents\".\"region_id\" IS NOT NULL)"
        },
        "documents_ready_has_file": {
          "name": "documents_ready_has_file",
          "value": "\"documents\".\"storage_status\" <> 'ready' OR (\"documents\".\"object_key\" IS NOT NULL AND \"documents\".\"mime_type\" = 'application/pdf' AND \"documents\".\"byte_size\" > 0 AND \"documents\".\"uploaded_at\" IS NOT NULL)"
        },
        "documents_published_is_ready": {
          "name": "documents_published_is_ready",
          "value": "\"documents\".\"publication_status\" <> 'published' OR \"documents\".\"storage_status\" = 'ready'"
        },
        "documents_not_self_superseding": {
          "name": "documents_not_self_superseding",
          "value": "\"documents\".\"supersedes_document_id\" IS NULL OR \"documents\".\"supersedes_document_id\" <> \"documents\".\"id\""
        }
      },
